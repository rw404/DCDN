# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.venv/

# Credentials and local environment
.env
.env.*
*.pem
*.key

# Telemetry and external experiment trackers (disabled by policy)
wandb/
mlruns/

# Public data, regenerable caches, and model checkpoints
data/*
!data/manifests/
!data/manifests/**
cache/
checkpoints/
*.ckpt
*.pt
*.pth

# Run payloads: keep compact registry/commands, not logs or model artifacts
runs/*
!runs/.gitkeep
!runs/registry/
!runs/registry/**
!runs/commands/
!runs/commands/**

# Compact result tables and summaries are versioned explicitly
results/*
!results/.gitkeep
!results/**/
!results/**/*.csv
!results/**/*.json
!results/**/*.md
!results/**/*.sha256
!results/**/*.yaml
!results/**/*.yml

# Runtime advisory locks are local process state, never durable evidence
artifacts/protocol_state/**/.active_protocol.yaml.lock

# Third-party checkouts are pinned in manifests rather than vendored implicitly
third_party/*
!third_party/README.md

# Legacy LaTeX build products (the supplied PDF is retained explicitly)
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz

# Editor and OS noise
.DS_Store
*.swp
*~
